{
  "name": "orderflow",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "db:types": "supabase gen types typescript --linked --schema public > packages/types/src/database.ts",
    "db:push": "supabase db push --linked",
    "db:status": "supabase migration list --linked"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "supabase": "^2.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.4"
}
